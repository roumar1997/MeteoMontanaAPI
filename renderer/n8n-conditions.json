{
  "name": "Cumbre — Condiciones del finde (diario, 3 comunidades)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 8 * * *"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Cada mañana 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "IG_USER_ID",
              "value": "17841427677381913",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "IG_TOKEN",
              "value": "PON_AQUI_EL_TOKEN_DE_PAGINA",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "RENDERER",
              "value": "https://overflowing-magic-production-e39c.up.railway.app",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config (edítame)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Una historia por comunidad. Edita la lista si quieres más/menos.\nconst c = $input.first().json;\nconst regiones = [\"Comunidad de Madrid\", \"Cataluña\", \"Andalucía\"];\nreturn regiones.map(r => ({ json: {\n  IG_USER_ID: c.IG_USER_ID,\n  IG_TOKEN: c.IG_TOKEN,\n  RENDERER: c.RENDERER,\n  HISTORIA_URL: \"https://api.climbingteams.com/api/social/conditions/html?region=\" + r\n}}));"
      },
      "id": "regiones",
      "name": "Regiones (edítame)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "image_url",
              "value": "={{ $json.RENDERER }}/render?url={{ encodeURIComponent($json.HISTORIA_URL) }}",
              "type": "string"
            }
          ]
        },
        "include": "all",
        "options": {}
      },
      "id": "buildurl",
      "name": "Construir image_url",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.image_url }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "prewarm",
      "name": "Calentar renderer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Config (edítame)').item.json.IG_USER_ID }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $('Construir image_url').item.json.image_url }}"
            },
            {
              "name": "media_type",
              "value": "STORIES"
            },
            {
              "name": "access_token",
              "value": "={{ $('Config (edítame)').item.json.IG_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "container",
      "name": "IG: crear contenedor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        300
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Config (edítame)').item.json.IG_USER_ID }}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "access_token",
              "value": "={{ $('Config (edítame)').item.json.IG_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "publish",
      "name": "IG: publicar story",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        300
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    }
  ],
